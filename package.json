{
  "name": "warchest-ai-cli",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "latest",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "bun run --watch index.ts",
    "start": "bun index.ts",
    "setup-draft": "bun run src/scripts/setup-draft.ts",
    "play": "bun run src/scripts/play.ts",
    "board": "bun run src/scripts/build-playmat-1v1.ts",
    "terrain": "bun run src/scripts/build-terrain-svgs.ts",
    "board-terrain": "bun run src/scripts/build-board-from-terrain.ts",
    "render": "bun run src/scripts/render-board-terminal.ts",
    "test": "bun test",
    "check": "bun tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:all": "bun run check && bun run lint && bun test"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": ["eslint --fix"]
  }
}